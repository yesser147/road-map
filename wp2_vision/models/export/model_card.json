{
  "name": "roadvision-detector",
  "version": "0.1.0",
  "architecture": "YOLOv8s",
  "base": "dronefreak/rdd2022-yolov8s (RDD2022) fine-tuned on WP2 unified dataset",
  "input": {
    "shape": [
      1,
      3,
      640,
      640
    ],
    "layout": "NCHW",
    "color": "RGB",
    "scale": "0..1 (divide by 255)",
    "resize": "letterbox to square, pad value 114"
  },
  "output": {
    "shape": [
      1,
      9,
      8400
    ],
    "format": "cx,cy,w,h + per-class scores, needs NMS (iou 0.5)"
  },
  "classes": {
    "0": {
      "name": "longitudinal_crack",
      "fr": "fissure longitudinale",
      "is_defect": true,
      "rdd": "D00"
    },
    "1": {
      "name": "transverse_crack",
      "fr": "fissure transversale",
      "is_defect": true,
      "rdd": "D10"
    },
    "2": {
      "name": "alligator_crack",
      "fr": "faïençage",
      "is_defect": true,
      "rdd": "D20"
    },
    "3": {
      "name": "pothole",
      "fr": "nid-de-poule",
      "is_defect": true,
      "rdd": "D40"
    },
    "4": {
      "name": "manhole",
      "fr": "plaque d'égout",
      "is_defect": false,
      "rdd": null
    }
  },
  "files": {
    "onnx_fp32": {
      "path": "models/export/roadvision_fp32.onnx",
      "size_mb": 44.75
    },
    "onnx_int8": {
      "path": "models/export/roadvision_int8.onnx",
      "size_mb": 11.49
    }
  },
  "license": "AGPL-3.0 (Ultralytics / base weights)"
}