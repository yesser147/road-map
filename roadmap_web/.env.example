# "http" = API Spring Boot (roadmap_api) · "mock" = données simulées dans le navigateur, sans serveur
VITE_API_MODE=http
# Chemin de l'API vu par le navigateur (relayé par Vite en développement)
VITE_API_BASE_URL=/api/v1
# Adresse du serveur Spring Boot pour le relais de développement
API_PROXY_TARGET=http://localhost:8080
