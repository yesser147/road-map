{
  "name": "roadmap-web",
  "private": true,
  "version": "0.1.0",
  "description": "Road Map - plateforme web (carte des dégradations routières). Front-end, données simulées tant que l'API WP4 n'est pas branchée.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "dev:phone": "cross-env VITE_HTTPS=1 vite --host",
    "dev:mock": "vite --mode mock"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
